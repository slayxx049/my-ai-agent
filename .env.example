POSTGRES_USER=omni
POSTGRES_PASSWORD=replace-this-local-password
POSTGRES_DB=omni
# Local Docker PostgreSQL option:
# DATABASE_URL=postgresql+psycopg://omni:replace-this-local-password@127.0.0.1:5432/omni

# Supabase option: copy the full Session pooler URI from Supabase → Connect.
# Put it in the GitHub Codespaces secret named DATABASE_URL, not in this file.
# Example shape only; use your project's exact pooler host and username:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
OMNI_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# Multi-model answer engine (set these as GitHub Codespaces secrets, not here).
# OMNI_ANSWER_MODELS=provider-a/model-id,provider-b/model-id
# OMNI_SYNTHESIS_MODEL=provider-a/model-id
# OMNI_VERIFIER_MODEL=provider-b/model-id
# OPENAI_API_KEY=never-put-real-keys-in-this-file
# ANTHROPIC_API_KEY=never-put-real-keys-in-this-file
# GEMINI_API_KEY=never-put-real-keys-in-this-file
